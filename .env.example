# Azure OpenAI — required for the in-app AI chat agent
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here

# Two selectable deployments shown in the chat model picker ("mini" / "nano").
# The handles and their env var names are defined in board_data/models.yml.
# Add entries there to register new deployments; set the corresponding env vars here.
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_NANO=gpt-5.4-nano

# Optional — context window (tokens) used for the ctx% indicator. Default 128000.
KANBAI_CONTEXT_WINDOW=128000

# Optional — Azure OpenAI API version. Default 2025-04-01-preview.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Vault passphrase — can be set here in .env (gitignored) or in your shell profile.
# .env is the simplest option for local use: just fill in the value below.
# For team use, share the passphrase out-of-band (e.g. 1Password) — everyone
# sets the same value so the derived AES key matches and .db decrypts.
KANBAI_VAULT_PASS=your-shared-passphrase
